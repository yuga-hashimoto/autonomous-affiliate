# Copy to .env locally; never commit credentials.
# These are placeholders, not live configurations.
NODE_ENV=development
DATABASE_URL=
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_ACCESS_KEY_ID=
EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
SITE_BASE_URL=
GITHUB_TOKEN=
GOOGLE_SEARCH_CONSOLE_PROPERTY=
GOOGLE_APPLICATION_CREDENTIALS_PATH=
GA4_PROPERTY_ID=
# Public GA4 web-stream id (G-XXXXXXXX); build-time. Empty = no analytics tag in the site.
GA4_MEASUREMENT_ID=
# Public Search Console HTML-tag token; build-time. Empty = no ownership meta tag in the site.
GSC_VERIFICATION_TOKEN=
AFFILIATE_REPORT_SOURCE=
PUBLISH_ENABLED=false
