---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import SideInfo from "../components/SideInfo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortByNewest } from "../lib/articles";

const LATEST_COUNT = 8;
const articles = sortByNewest(await getCollection("articles"));
const latest = articles.slice(0, LATEST_COUNT);

const rules = [
  {
    title: "公式の情報だけを根拠にしています。",
    body: "料金ページや利用規約など、事業者が公開している情報を参照し、記事ごとに出典と確認日を載せています。",
  },
  {
    title: "条件をそろえて総額を計算しています。",
    body: "比較する期間・通貨・課金単位をそろえ、計算式と前提を省かずに示します。",
  },
  {
    title: "確認できない項目は断定しません。",
    body: "公式情報で確認できなかった項目は「UNKNOWN」と表示し、0円や確定情報としては扱いません。",
  },
];
---

<BaseLayout title="総額比較｜公式料金に基づく比較・試算">
  <section class="top-lead">
    <div class="container">
      <h1>公式の料金・条件をもとにした総額比較サイト</h1>
      <p>
        各社の公式ページに載っている料金や契約条件を確認し、期間や課金単位をそろえて総額を計算しています。確認できなかった項目は「UNKNOWN」と表示します。
      </p>
      <p class="lead-links"><a href="/methodology/">比較・試算の方法を見る</a></p>
    </div>
  </section>

  <div class="container">
    <div class="page-cols">
      <div class="page-main">
        <section class="section" aria-labelledby="latest-heading">
          <h2 class="section-title" id="latest-heading">新着記事</h2>
          {
            latest.length > 0 ? (
              <ul class="card-list">
                {latest.map((article) => (
                  <ArticleCard article={article} />
                ))}
              </ul>
            ) : (
              <div class="empty-state">
                <p>公開済みの記事はまだありません。</p>
              </div>
            )
          }
          {
            articles.length > LATEST_COUNT && (
              <p class="section-foot">
                <a href="/articles/">記事一覧を見る（全{articles.length}件）</a>
              </p>
            )
          }
        </section>

        <section class="section" aria-labelledby="policy-heading">
          <h2 class="section-title" id="policy-heading">このサイトの比較ルール</h2>
          <div class="rule-box">
            <ul class="rule-list">
              {
                rules.map((rule) => (
                  <li>
                    <strong>{rule.title}</strong>
                    {rule.body}
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="section-foot"><a href="/editorial-policy/">編集・広告掲載方針</a></p>
        </section>
      </div>

      <div class="page-side">
        <SideInfo currentPath={Astro.url.pathname} />
      </div>
    </div>
  </div>
</BaseLayout>
