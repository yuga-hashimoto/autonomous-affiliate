---
import { getCollection, render } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Toc from "../../components/Toc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME, formatDate, isoDate, readingMinutes, relatedArticles } from "../../lib/articles";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { title, description, pubDate, disclosure } = article.data;

const related = relatedArticles(article, await getCollection("articles"));
const minutes = readingMinutes(article.body ?? "");
const path = `/articles/${article.id}/`;
const site = Astro.site ?? new URL("https://example.com");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: title,
      description,
      datePublished: pubDate,
      dateModified: pubDate,
      inLanguage: "ja",
      mainEntityOfPage: new URL(path, site).href,
      publisher: { "@type": "Organization", name: SITE_NAME },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "ホーム", item: new URL("/", site).href },
        { "@type": "ListItem", position: 2, name: "記事一覧", item: new URL("/articles/", site).href },
        { "@type": "ListItem", position: 3, name: title, item: new URL(path, site).href },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} path={path} ogType="article" jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumb items={[{ label: "ホーム", href: "/" }, { label: "記事一覧", href: "/articles/" }, { label: title }]} />

    <div class="page-cols">
      <article class="paper">
        <header class="article-header">
          <h1>{title}</h1>
          <p class="article-meta">
            <span>確認日 <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time></span>
            <span>読了目安 約{minutes}分</span>
          </p>
          {
            disclosure && (
              <aside class="disclosure" aria-label="広告表記">
                <span class="pr-badge">PR</span>
                <p>{disclosure}</p>
              </aside>
            )
          }
        </header>

        <Toc headings={headings} variant="inline" />

        <div class="prose article-body">
          <Content />
        </div>
      </article>

      <Toc headings={headings} variant="aside" />
    </div>

    <aside class="method-note" aria-label="比較方法について">
      <p>
        料金は公式情報の確認日時点のものです。比較の前提や、確認できなかった項目の扱いは
        <a href="/methodology/">比較・試算の方法</a>と<a href="/editorial-policy/">編集・広告掲載方針</a>をご覧ください。
      </p>
    </aside>

    {
      related.length > 0 && (
        <section class="article-footer" aria-labelledby="related-heading">
          <h2 class="section-title" id="related-heading">
            あわせて読みたい記事
          </h2>
          <ul class="card-list">
            {related.map((item) => (
              <ArticleCard article={item} />
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  // Highlights the table-of-contents entry for the section being read.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  const sections = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((element): element is HTMLElement => element !== null);

  if (links.length > 0 && sections.length > 0) {
    const OFFSET_PX = 120;
    let frame = 0;
    const update = (): void => {
      frame = 0;
      let current: HTMLElement | undefined;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= OFFSET_PX) current = section;
        else break;
      }
      for (const link of links) {
        const active = current !== undefined && decodeURIComponent(link.hash.slice(1)) === current.id;
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };
    window.addEventListener(
      "scroll",
      () => {
        if (frame === 0) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>
