---
interface Props {
  title: string;
  description?: string;
  path?: string;
}
const { title, description = "公式一次情報に基づく比較・料金試算の自動生成メディア（設計段階）", path } = Astro.props;
const site = Astro.site ?? new URL("https://example.com");
const canonical = new URL(path ?? Astro.url.pathname, site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <style is:global>
      :root {
        color-scheme: light dark;
        font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", sans-serif;
        line-height: 1.7;
      }
      body { margin: 0 auto; max-width: 48rem; padding: 1rem; }
      .disclosure {
        border: 1px solid #888;
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
        margin-bottom: 1rem;
      }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid #999; padding: 0.35rem 0.5rem; text-align: left; }
      a[rel~="sponsored"]::after { content: " [PR]"; font-size: 0.8em; }
      footer { margin-top: 2rem; font-size: 0.85rem; border-top: 1px solid #999; padding-top: 0.5rem; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">ホーム</a> · <a href="/about/">このサイトについて</a> · <a href="/privacy/">プライバシー</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>本サイトの記事は公式一次情報に基づく説明・試算であり、実機検証を含みません。</p>
    </footer>
  </body>
</html>
