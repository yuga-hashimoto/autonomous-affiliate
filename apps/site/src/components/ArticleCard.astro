---
import { formatDate, isoDate, type ArticleLike } from "../lib/articles";

interface Props {
  article: ArticleLike;
  /** Home cards add a "read" affordance; archive rows stay compact. */
  showMore?: boolean;
}

const { article, showMore = false } = Astro.props;
const { title, description, pubDate, offerIds } = article.data;
---

<li class="card">
  <p class="card-meta">
    <time datetime={isoDate(pubDate)}>確認日 {formatDate(pubDate)}</time>
    {offerIds.length > 0 && <span class="pr-badge">PR含む</span>}
  </p>
  <h3 class="card-title">
    <a class="card-link" href={`/articles/${article.id}/`}>{title}</a>
  </h3>
  <p class="card-desc">{description}</p>
  {showMore && <span class="card-more" aria-hidden="true">記事を読む →</span>}
</li>
